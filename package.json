{
  "name": "wisewords-monorepo",
  "private": true,
  "workspaces": [
    "backend/extensions/*",
    "backend/shared/*",
    "backend/search-services/*",
    "backend/llm-services/*",
    "backend/gateway/*",
    "backend/orchestration/*",
    "frontend"
  ],
  "scripts": {
    "build": "echo 'Building WiseWords workspace...'",
    "dev:backend": "bun run backend/gateway/wisewords-engine/src/index.ts",
    "dev:frontend": "bun run backend/gateway/wisewords-engine/src/index.ts & npx serve frontend/src -p 4200",
    "start": "bun run backend/gateway/wisewords-engine/src/index.ts & npx serve frontend/src -p 4200",
    "dev": "bun run backend/gateway/wisewords-engine/src/index.ts & npx serve frontend/src -p 4200",
    "test": "bun test backend/gateway/wisewords-engine/test/gateway.test.ts"
  }
}
